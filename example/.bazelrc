common --enable_platform_specific_config
common:linux --registry=file://%workspace%/..
common:linux --registry=https://bcr.bazel.build
common:windows --registry=file:///%workspace%/..
common:windows --registry=https://bcr.bazel.build

import %workspace%/../dev/build.bazelrc
build:linux --extra_execution_platforms=//:linux_x86_64_musl

# Rust's musl toolchain provides its own CRT objects. Link directly with
# rust-lld; a C compiler driver can add a second set of CRT objects.
build --@rules_rust//rust/settings:toolchain_linker_preference=rust
