load("@rules_qemu//qemu:qemu_system_toolchain.bzl", "qemu_system_toolchain")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load(":qemu_runfiles.bzl", "qemu_runfiles")

_HOST = ["@platforms//cpu:x86_64", "@platforms//os:linux", "@zig_sdk//libc:musl"]
_GUEST = ["@platforms//cpu:x86_64", "@platforms//os:none"]

platform(
    name = "linux_x86_64_musl",
    constraint_values = _HOST,
)

platform(
    name = "x86_64_baremetal",
    constraint_values = _GUEST,
)

rust_binary(
    name = "hello_x86_64",
    srcs = ["hello_x86_64.rs"],
    compile_data = ["pvh.ld"],
    edition = "2021",
    rustc_flags = [
        "-Cpanic=abort",
        "-Crelocation-model=static",
        "-Clink-arg=-T$(execpath :pvh.ld)",
    ],
    tags = ["manual"],  # Build via :boot_inputs, which applies the guest transition.
    target_compatible_with = _GUEST,
)

qemu_system_toolchain(
    name = "qemu_x86_64_impl",
    accel = "kvm",
    machine = "q35",
    qemu_img = "@qemu//:qemu-img",
    qemu_system = "@qemu//:qemu-system-x86_64",
    system_data = "@qemu//:firmware",
    system_data_anchor = "@qemu//:firmware",
    system_target = "x86_64-softmmu",
    target_arch = "x86_64",
)

toolchain(
    name = "qemu_x86_64_toolchain",
    exec_compatible_with = _HOST,
    target_compatible_with = _HOST,
    toolchain = ":qemu_x86_64_impl",
    toolchain_type = "@rules_qemu//qemu:exec_toolchain_type",
)

qemu_runfiles(
    name = "boot_inputs",
    guest = ":hello_x86_64",
)

rust_test(
    name = "x86_64_uart_test",
    size = "small",
    srcs = ["x86_64_uart_test.rs"],
    data = [":boot_inputs"],
    edition = "2021",
    rustc_env = {"BOOT_INPUTS": "$(rlocationpath :boot_inputs)"},
    tags = ["manual", "requires-kvm"],
    deps = ["@rules_rust//rust/runfiles"],
)
