load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@qemu_rules_qemu_example//:source_toolchain.bzl", "source_toolchain")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load(":qemu_runfiles.bzl", "qemu_runfiles")

_LINUX = ["@platforms//cpu:x86_64", "@platforms//os:linux", "@zig_sdk//libc:musl"]
_WINDOWS = ["@platforms//cpu:x86_64", "@platforms//os:windows"]
_GUEST = ["@platforms//cpu:x86_64", "@platforms//os:none"]

platform(
    name = "linux_x86_64_musl",
    constraint_values = _LINUX,
)

platform(
    name = "x86_64_baremetal",
    constraint_values = _GUEST,
)

rust_binary(
    name = "hello_x86_64",
    srcs = ["hello_x86_64.rs"],
    compile_data = ["pvh.ld"],
    edition = "2021",
    rustc_flags = [
        "-Cpanic=abort",
        "-Crelocation-model=static",
        "-Clink-arg=-T$(execpath :pvh.ld)",
    ],
    tags = ["manual"],  # Build via :boot_inputs, which applies the guest transition.
    target_compatible_with = _GUEST,
)

# QEMU still enters SeaBIOS, whose PVH option ROM reads the ELF entry from
# fw_cfg. The in-kernel APIC can also register the VAPIC option ROM.
copy_to_directory(
    name = "pvh_bios",
    srcs = ["@qemu//:pc-bios-files"],
    include_external_repositories = [package_relative_label("@qemu//:pc-bios-files").workspace_name],
    include_srcs_patterns = ["bios-256k.bin", "pvh.bin", "kvmvapic.bin"],
    root_paths = ["pc-bios"],
)

source_toolchain(
    name = "qemu_x86_64_impl",
    qemu_img = "@qemu//:qemu-img",
    system_data = ":pvh_bios",
)

[
    toolchain(
        name = "qemu_" + os + "_x86_64",
        exec_compatible_with = constraints,
        target_compatible_with = constraints,
        toolchain = ":qemu_x86_64_impl",
        toolchain_type = "@rules_qemu//qemu:exec_toolchain_type",
    )
    for os, constraints in [("linux", _LINUX), ("windows", _WINDOWS)]
]

qemu_runfiles(
    name = "boot_inputs",
    guest = ":hello_x86_64",
)

rust_test(
    name = "x86_64_uart_test",
    size = "small",
    srcs = ["x86_64_uart_test.rs"],
    args = ["--nocapture"],
    data = [":boot_inputs"],
    edition = "2021",
    rustc_env = {"BOOT_INPUTS": "$(rlocationpath :boot_inputs)"},
    tags = ["manual"],
    deps = ["@rules_rust//rust/runfiles"],
)
