module(name = "qemu_bare_metal_rust_example")

bazel_dep(name = "qemu", version = "11.1.2")
bazel_dep(name = "rules_qemu", version = "0.3.0")
bazel_dep(name = "libslirp", version = "4.9.5", dev_dependency = True)
bazel_dep(name = "rules_rust", version = "0.72.0")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
bazel_dep(name = "qemu_rules_qemu_example")
local_path_override(module_name = "qemu_rules_qemu_example", path = "../dev/rules_qemu")

single_version_override(
    module_name = "hermetic_cc_toolchain",
    version = "4.3.0",
    patch_strip = 1,
    patches = ["//:zig-windows-params.patch"],
)

qemu = use_extension("@qemu//bazel/config:targets.bzl", "qemu_targets")
qemu.configure(profile = "default")

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")
register_toolchains(
    "@zig_sdk//toolchain:windows_amd64",
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//libc_aware/toolchain:linux_amd64_gnu.2.38",
    "@zig_sdk//libc_aware/toolchain:linux_amd64_musl",
    "//:qemu_linux_x86_64",
    "//:qemu_windows_x86_64",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(extra_target_triples = [], versions = ["1.91.1"])

rust.repository_set(
    name = "rust_linux_x86_64",
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:none"],
    target_triple = "x86_64-unknown-none",
    versions = ["1.91.1"],
)
rust.repository_set(
    name = "rust_windows_x86_64",
    exec_triple = "x86_64-pc-windows-msvc",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:none"],
    target_triple = "x86_64-unknown-none",
    versions = ["1.91.1"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
