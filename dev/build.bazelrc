build:linux --jobs=2
build:windows --jobs=4
test:windows --action_env=PATH
test:windows --test_env=PATH
build:linux --platforms=//:linux_x86_64_musl
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build:linux --incompatible_strict_action_env
build:linux --action_env=PATH=/nonexistent
build:linux --host_action_env=PATH=/nonexistent

test:linux --extra_execution_platforms=@platforms//host:host,//:linux_x86_64_musl
# Bazel's test and XML wrappers, not QEMU or its build, need PATH.
test:linux --test_env=PATH=/usr/bin:/bin
