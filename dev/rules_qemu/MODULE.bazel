module(name = "qemu_rules_qemu_example")

bazel_dep(name = "qemu", version = "11.1.2")
bazel_dep(name = "rules_qemu", version = "0.3.0")
bazel_dep(name = "bazel_lib", version = "3.2.2", dev_dependency = True)
bazel_dep(name = "rules_python", version = "2.5.1", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

# Use response files for Zig archives and links on Windows.
single_version_override(
    module_name = "hermetic_cc_toolchain",
    version = "4.3.0",
    patch_strip = 1,
    patches = ["//:zig-windows-params.patch"],
)

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains", dev_dependency = True)
use_repo(zig, "zig_sdk")
register_toolchains(
    "@zig_sdk//toolchain:windows_amd64",
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//libc_aware/toolchain:linux_amd64_gnu.2.38",
    "@zig_sdk//libc_aware/toolchain:linux_amd64_musl",
    "//:source_system_linux_x86_64",
    "//:source_system_windows_x86_64",
    dev_dependency = True,
)
