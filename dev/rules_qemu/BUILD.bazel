load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_python//python:py_test.bzl", "py_test")
load(":source_toolchain.bzl", "source_toolchain")
load(":system_probe_test.bzl", "system_probe_data")

_LINUX_X86_64 = ["@platforms//os:linux", "@platforms//cpu:x86_64"]
_MUSL_EXEC = _LINUX_X86_64 + ["@zig_sdk//libc:musl"]

platform(
    name = "linux_x86_64_musl",
    constraint_values = _MUSL_EXEC,
)

# The API expects one directory File for the -L anchor. Stage individually
# tracked release files into a tree artifact instead of using a source directory.
copy_to_directory(
    name = "pc_bios",
    srcs = ["@qemu//:pc-bios-files"],
    include_external_repositories = [package_relative_label("@qemu//:pc-bios-files").workspace_name],
    root_paths = ["pc-bios"],
)

source_toolchain(
    name = "source_system_impl",
    qemu_img = "@qemu//:qemu-img",
    system_data = ":pc_bios",
)

[
    toolchain(
        name = "source_system_" + os + "_x86_64",
        exec_compatible_with = constraints,
        toolchain = ":source_system_impl",
        toolchain_type = "@rules_qemu//qemu:exec_toolchain_type",
    )
    for os, constraints in [
        ("linux", _MUSL_EXEC),
        ("windows", ["@platforms//os:windows", "@platforms//cpu:x86_64"]),
    ]
]

system_probe_data(name = "system_probe_data")

py_test(
    name = "system_probe_test",
    srcs = ["system_probe.py"],
    main = "system_probe.py",
    args = ["$(rlocationpath :system_probe_data)"],
    data = [":system_probe_data"],
    deps = ["//probe:accelerator", "@rules_python//python/runfiles"],
)
